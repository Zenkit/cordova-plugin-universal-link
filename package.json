{
  "name": "@zenkit-dev/cordova-plugin-universal-link",
  "version": "1.2.4-dev.7",
  "description": "Cordova plugin to add in your application support for Universal Links (iOS 9) and Deep Links (Android). Basically, open application through the link in the browser.",
  "cordova": {
    "id": "cordova-plugin-universal-link",
    "platforms": [
      "ios",
      "android"
    ]
  },
  "repository": "https://github.com/zenkit/cordova-plugin-universal-link.git",
  "keywords": [
    "cordova",
    "links",
    "universal",
    "deep links",
    "universal links",
    "ecosystem:cordova",
    "cordova-ios",
    "cordova-android",
    "ios",
    "android"
  ],
  "dependencies": {
    "xml2js": "^0.6.2",
    "plist": "^3.1.1"
  },
  "author": "Nikolay Demyankov for Nordnet Bank AB",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gojob-1337/cordova-plugin-universal-link/issues"
